/target/
/frontend/node_modules/
/frontend/.svelte-kit/
/frontend/build/
/frontend/src/lib/generated/*.ts
!/frontend/src/lib/generated/.gitkeep
*.db
*.db-shm
*.db-wal
.env

# ts-rs intermediate output; the real consumer is frontend/src/lib/generated/
/crates/pult-schema/bindings/

# Demo runs: showfile, logs, and anything else scripts/demo.sh creates.
/.demo/

# The simulator panel, built into the desktop app rather than committed.
/tools/openhaunt-node-sim-gui/ui/node_modules/
/tools/openhaunt-node-sim-gui/ui/dist/

# The plugins workspace builds its own components; scripts/build-plugins.sh
# copies each beside its manifest, where the station loads it from. Built, not
# committed — and an operator's own plugin config is theirs, not the repo's.
/plugins/target/
/plugins/*/*.wasm
/plugins/*/config.toml

# Tauri's generated permission schemas, written beside each desktop shell.
/crates/pult-gui/gen/
/tools/openhaunt-node-sim-gui/gen/

# Vitest's cache, when it is run from the repository root rather than frontend/.
/node_modules/
