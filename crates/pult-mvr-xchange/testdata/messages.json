    },
    {
      "name": "a message from a later version of somebody else's software",
      "type": "unknown",
      "json": { "Type": "MVR_SOMETHING_NOT_YET_WRITTEN", "Payload": { "x": 1 } }
    }
  ],
  "packages": [
    {
      "note": [
        "The byte layout, pinned as data so a wrong magic or a flipped endianness",
        "cannot pass by round-tripping through this crate's own encoder.",
        "header 778682 = 0x000BE1BA, version 1, number 0, count 1, kind, length, payload."
      ],
      "name": "an empty JSON object",
      "kind": "json",
      "payload_utf8": "{}",
      "hex": "000be1ba000000010000000000000001000000000000000000000002 7b7d"
    },
    {
      "name": "four bytes of a zip",
      "kind": "file",
      "payload_hex": "504b0304",
      "hex": "000be1ba000000010000000000000001000000010000000000000004 504b0304"
    }
  ]
}
