      "json": {
        "Type": "MVR_REQUEST",
        "FromStationUUID": "",
        "FileUUID": null
      },
      "strict_json": { "Type": "MVR_REQUEST" }
    },
    {
      "name": "request naming a station as an array",
      "type": "MVR_REQUEST",
      "lenient": "Table 74 types FromStationUUID as an array; the example writes a string.",
      "json": {
        "Type": "MVR_REQUEST",
        "FileUUID": "0e8b1a3f-51ba-4b1e-8f2f-1f7c2e1e2a01",
        "FromStationUUID": ["4aa291a1-1a62-45fe-aabc-e90e5e2399a8"]
      },
      "strict_json": {
        "Type": "MVR_REQUEST",
        "FileUUID": "0e8b1a3f-51ba-4b1e-8f2f-1f7c2e1e2a01",
        "FromStationUUID": "4aa291a1-1a62-45fe-aabc-e90e5e2399a8"
      }
    },
    {
      "name": "request refused",
      "type": "MVR_REQUEST_RET",
      "json": {
        "Type": "MVR_REQUEST_RET",
        "OK": false,
        "Message": "The MVR is not available on this client"
      }
    },
    {
