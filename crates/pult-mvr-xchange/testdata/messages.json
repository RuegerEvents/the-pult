{
  "note": [
    "The specification's own worked examples, verbatim, plus the ones that show where",
    "it disagrees with itself. Read by tests/corpus.rs.",
    "",
    "`type` is what the message must parse as. `lenient` marks a case that exists only",
    "because a strict reading of the document would refuse a message the document",
    "itself prints — see message.rs. `strict_json` is the JSON this crate writes when",
    "it sends that message, where that differs from what it accepts."
  ],
  "messages": [
    {
      "name": "join, as the spec prints it",
      "type": "MVR_JOIN",
      "json": {
        "Type": "MVR_JOIN",
        "Provider": "MVRApplication",
        "verMajor": 1,
        "verMinor": 6,
        "StationUUID": "4aa291a1-1a62-45fe-aabc-e90e5e2399a8",
        "StationName": "MVR Application from user A at location B",
        "Commits": []
      }
    },
    {
      "name": "join carrying a commit history",
      "type": "MVR_JOIN",
      "json": {
        "Type": "MVR_JOIN",
        "Provider": "the-pult",
        "verMajor": 1,
        "verMinor": 6,
        "StationUUID": "4aa291a1-1a62-45fe-aabc-e90e5e2399a8",
        "StationName": "Festival",
        "Commits": [
          {
            "verMajor": 1,
            "verMinor": 6,
            "FileSize": 4096,
            "FileUUID": "0e8b1a3f-51ba-4b1e-8f2f-1f7c2e1e2a01",
            "StationUUID": "4aa291a1-1a62-45fe-aabc-e90e5e2399a8",
            "ForStationsUUID": [],
            "Comment": "Moved the overhead truss upstage 500",
            "FileName": "Festival-2026-09-05.mvr"
          }
        ]
      }
    },
    {
      "name": "join answered",
      "type": "MVR_JOIN_RET",
      "json": {
        "Type": "MVR_JOIN_RET",
        "OK": true,
        "Message": "",
        "verMajor": 1,
        "verMinor": 6,
        "StationUUID": "a7669ff9-bd61-4486-aea6-c190f8ba6b8c",
        "StationName": "MVR Application from user A at location B",
        "Commits": []
      }
    },
    {
      "name": "leave, spelled as the table says",
      "type": "MVR_LEAVE",
      "json": {
        "Type": "MVR_LEAVE",
        "FromStationUUID": "4aa291a1-1a62-45fe-aabc-e90e5e2399a8"
      }
    },
    {
      "name": "leave, spelled as the example says",
      "type": "MVR_LEAVE",
      "lenient": "Table 70 names FromStationUUID; the example under it writes StationUUID.",
      "json": {
        "Type": "MVR_LEAVE",
        "StationUUID": "4aa291a1-1a62-45fe-aabc-e90e5e2399a8"
      },
      "strict_json": {
        "Type": "MVR_LEAVE",
        "FromStationUUID": "4aa291a1-1a62-45fe-aabc-e90e5e2399a8"
      }
    },
    {
      "name": "leave answered",
      "type": "MVR_LEAVE_RET",
      "json": { "Type": "MVR_LEAVE_RET", "OK": true, "Message": "" }
    },
    {
      "name": "commit, as the spec prints it",
      "type": "MVR_COMMIT",
      "lenient": "The example omits StationUUID and FileName, which Table 72 has.",
      "json": {
        "Type": "MVR_COMMIT",
        "verMajor": 1,
        "verMinor": 6,
        "FileUUID": "0e8b1a3f-51ba-4b1e-8f2f-1f7c2e1e2a01",
        "ForStationsUUID": [],
        "FileSize": 256,
        "Comment": "My complete description of what I have changed"
      }
    },
    {
      "name": "commit addressed to two stations",
      "type": "MVR_COMMIT",
      "json": {
        "Type": "MVR_COMMIT",
        "verMajor": 1,
        "verMinor": 6,
        "FileSize": 256,
        "FileUUID": "0e8b1a3f-51ba-4b1e-8f2f-1f7c2e1e2a01",
        "StationUUID": "4aa291a1-1a62-45fe-aabc-e90e5e2399a8",
        "ForStationsUUID": [
          "a7669ff9-bd61-4486-aea6-c190f8ba6b8c",
          "b1c2d3e4-0000-4000-8000-000000000001"
        ],
        "Comment": "For previz only",
        "FileName": "wip.mvr"
      }
    },
    {
      "name": "commit answered",
      "type": "MVR_COMMIT_RET",
      "json": { "Type": "MVR_COMMIT_RET", "OK": true, "Message": "" }
    },
    {
      "name": "request, as the spec prints it",
      "type": "MVR_REQUEST",
