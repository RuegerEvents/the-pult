      "type": "MVR_NEW_SESSION_HOST",
      "json": {
        "Type": "MVR_NEW_SESSION_HOST",
        "ServiceName": "fancyProjectGroup._mvrxchange._tcp.local.",
        "ServiceURL": ""
      }
    },
    {
