{
  "about": [
    "One rig and a list of cases, read by two test suites: the Rust evaluator in",
    "crates/pult-schema/src/types/group.rs and the TypeScript one in",
    "frontend/src/lib/selection.ts. A selection query has to mean the same thing on a",
    "station and in a browser, and this file is what makes that a test rather than a",
    "promise. It lives outside both crates because neither owns it.",
    "",
    "A case with no `previous` key is a saved group: nothing outside the query holds an",
    "order, so a Manual order uses the list it carries. A case whose `previous` is a",
    "list — including an empty one — is a live selection handing the evaluator the",
    "order an operator dragged the panel into, which wins over the query's own.",
    "",
    "Fixture ids end in the number they are called by below, so a failure is readable."
  ],
  "types": {
    "par": "70000000-0000-4000-8000-0000000000a1",
    "mover": "70000000-0000-4000-8000-0000000000a2"
  },
  "rig": [
    {
      "id": "f0000000-0000-4000-8000-000000000001",
      "name": "Front 1",
      "fixture_type_id": "70000000-0000-4000-8000-0000000000a1",
      "address": { "Dmx": { "universe": 1, "address": 1 } },
      "position": { "Point": { "x": -3.0, "y": 5.0, "z": 2.0 } },
      "live_values": {}
    },
    {
      "id": "f0000000-0000-4000-8000-000000000002",
      "name": "Front 2",
      "fixture_type_id": "70000000-0000-4000-8000-0000000000a1",
      "address": { "Dmx": { "universe": 1, "address": 9 } },
      "position": { "Point": { "x": -1.0, "y": 5.0, "z": 2.0 } },
      "live_values": {}
    },
    {
      "id": "f0000000-0000-4000-8000-000000000003",
      "name": "Front 3",
      "fixture_type_id": "70000000-0000-4000-8000-0000000000a1",
      "address": { "Dmx": { "universe": 1, "address": 17 } },
      "position": { "Point": { "x": 1.0, "y": 5.0, "z": 2.0 } },
      "live_values": {}
    },
    {
      "id": "f0000000-0000-4000-8000-000000000004",
      "name": "Front 4",
      "fixture_type_id": "70000000-0000-4000-8000-0000000000a1",
      "address": { "Dmx": { "universe": 1, "address": 25 } },
      "position": { "Point": { "x": 3.0, "y": 5.0, "z": 2.0 } },
      "live_values": {}
    },
    {
      "id": "f0000000-0000-4000-8000-000000000005",
      "name": "Mover back",
      "fixture_type_id": "70000000-0000-4000-8000-0000000000a2",
      "address": { "Dmx": { "universe": 1, "address": 33 } },
      "position": { "Axial": { "position": { "x": 0.0, "y": 6.0, "z": -4.0 }, "direction": { "x": 0.0, "y": -1.0, "z": 0.0 } } },
      "live_values": {}
    },
    {
      "id": "f0000000-0000-4000-8000-000000000006",
      "name": "In the case",
      "fixture_type_id": "70000000-0000-4000-8000-0000000000a2",
      "address": { "Dmx": { "universe": 1, "address": 41 } },
      "position": null,
      "live_values": {}
    }
  ],
  "cases": [
    {
      "name": "an empty query selects nothing",
      "query": { "clauses": [], "order": { "kind": "Manual", "order": [] } },
      "expected": []
    },
    {
      "name": "everything, placed or not",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Everything" } }],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000004",
        "f0000000-0000-4000-8000-000000000005",
        "f0000000-0000-4000-8000-000000000006"
      ]
    },
    {
      "name": "by type reaches an unplaced rig",
      "query": {
        "clauses": [
          { "combine": "Add", "term": { "kind": "OfType", "typeId": "70000000-0000-4000-8000-0000000000a2" } }
        ],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000005",
        "f0000000-0000-4000-8000-000000000006"
      ]
    },
    {
      "name": "by name, case-insensitive substring",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Named", "text": "  FRONT " } }],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000004"
      ]
    },
    {
      "name": "a literal list comes back in rig order, not in the order it was written",
      "query": {
        "clauses": [
          {
            "combine": "Add",
            "term": {
              "kind": "Ids",
              "ids": [
                "f0000000-0000-4000-8000-000000000003",
                "f0000000-0000-4000-8000-000000000001"
              ]
            }
          }
        ],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000003"
      ]
    },
    {
      "name": "a sphere takes the two nearest the middle",
      "query": {
        "clauses": [
          {
            "combine": "Add",
            "term": { "kind": "Sphere", "centre": { "x": 0.0, "y": 5.0, "z": 2.0 }, "radius": 2.0 }
          }
        ],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000003"
      ]
    },
    {
      "name": "a box, with its corners given the wrong way round",
      "query": {
        "clauses": [
          {
            "combine": "Add",
            "term": {
              "kind": "Box",
              "from": { "x": 0.0, "y": 6.0, "z": 3.0 },
              "to": { "x": -4.0, "y": 4.0, "z": 1.0 }
            }
          }
        ],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000002"
      ]
    },
    {
      "name": "a cone from front of house, opening upstage",
      "query": {
        "clauses": [
          {
            "combine": "Add",
            "term": {
              "kind": "Cone",
              "from": { "x": 0.0, "y": 5.0, "z": 10.0 },
              "direction": { "x": 0.0, "y": 0.0, "z": -1.0 },
              "angleDeg": 12.0,
              "reach": 20.0
            }
          }
        ],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000005"
      ]
    },
    {
      "name": "a cone with no direction to speak of selects nothing",
      "query": {
        "clauses": [
          {
            "combine": "Add",
            "term": {
              "kind": "Cone",
              "from": { "x": 0.0, "y": 5.0, "z": 10.0 },
              "direction": { "x": 0.0, "y": 0.0, "z": 0.0 },
              "angleDeg": 90.0,
              "reach": 100.0
            }
          }
        ],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": []
    },
    {
      "name": "add, then keep, then drop — read left to right",
      "query": {
        "clauses": [
          { "combine": "Add", "term": { "kind": "Everything" } },
          { "combine": "Keep", "term": { "kind": "OfType", "typeId": "70000000-0000-4000-8000-0000000000a1" } },
          { "combine": "Drop", "term": { "kind": "Named", "text": "Front 1" } }
        ],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000004"
      ]
    },
    {
      "name": "keep with nothing to narrow keeps nothing",
      "query": {
        "clauses": [{ "combine": "Keep", "term": { "kind": "Everything" } }],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": []
    },
    {
      "name": "adding the same fixture twice does not move it to the end",
      "query": {
        "clauses": [
          { "combine": "Add", "term": { "kind": "Named", "text": "Front" } },
          { "combine": "Add", "term": { "kind": "Ids", "ids": ["f0000000-0000-4000-8000-000000000001"] } }
        ],
        "order": { "kind": "Manual", "order": [] }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000004"
      ]
    },
    {
      "name": "by name, with the unplaced one sorting on its name like everything else",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Everything" } }],
        "order": { "kind": "ByName" }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000004",
        "f0000000-0000-4000-8000-000000000006",
        "f0000000-0000-4000-8000-000000000005"
      ]
    },
    {
      "name": "left to right, with the unplaced one at the end rather than at the origin",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Everything" } }],
        "order": { "kind": "ByAxis", "axis": "x" }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000005",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000004",
        "f0000000-0000-4000-8000-000000000006"
      ]
    },
    {
      "name": "right to left is the same order reversed",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Everything" } }],
        "order": { "kind": "ByAxis", "axis": "x", "descending": true }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000006",
        "f0000000-0000-4000-8000-000000000004",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000005",
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000001"
      ]
    },
    {
      "name": "outwards from a point, with the name breaking each tie",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Everything" } }],
        "order": { "kind": "ByDistance", "from": { "x": 0.0, "y": 5.0, "z": 2.0 } }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000004",
        "f0000000-0000-4000-8000-000000000005",
        "f0000000-0000-4000-8000-000000000006"
      ]
    },
    {
      "name": "a saved group's manual order, with everything it did not name on the end",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Everything" } }],
        "order": {
          "kind": "Manual",
          "order": [
            "f0000000-0000-4000-8000-000000000004",
            "f0000000-0000-4000-8000-000000000002"
          ]
        }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000004",
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000005",
        "f0000000-0000-4000-8000-000000000006"
      ]
    },
    {
      "name": "a manual order naming a fixture that has since been deleted",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Everything" } }],
        "order": {
          "kind": "Manual",
          "order": [
            "f0000000-0000-4000-8000-0000000000ff",
            "f0000000-0000-4000-8000-000000000003"
          ]
        }
      },
      "expected": [
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000004",
        "f0000000-0000-4000-8000-000000000005",
        "f0000000-0000-4000-8000-000000000006"
      ]
    },
    {
      "name": "a live selection's hand order wins over the one the query carries",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Everything" } }],
        "order": { "kind": "Manual", "order": ["f0000000-0000-4000-8000-000000000004"] }
      },
      "previous": [
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000001"
      ],
      "expected": [
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000004",
        "f0000000-0000-4000-8000-000000000005",
        "f0000000-0000-4000-8000-000000000006"
      ]
    },
    {
      "name": "an empty hand order is still a hand order, and still wins",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Everything" } }],
        "order": { "kind": "Manual", "order": ["f0000000-0000-4000-8000-000000000004"] }
      },
      "previous": [],
      "expected": [
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000004",
        "f0000000-0000-4000-8000-000000000005",
        "f0000000-0000-4000-8000-000000000006"
      ]
    },
    {
      "name": "a hand order is ignored by an order that is not manual",
      "query": {
        "clauses": [{ "combine": "Add", "term": { "kind": "Named", "text": "Front" } }],
        "order": { "kind": "ByName" }
      },
      "previous": [
        "f0000000-0000-4000-8000-000000000004",
        "f0000000-0000-4000-8000-000000000003"
      ],
      "expected": [
        "f0000000-0000-4000-8000-000000000001",
        "f0000000-0000-4000-8000-000000000002",
        "f0000000-0000-4000-8000-000000000003",
        "f0000000-0000-4000-8000-000000000004"
      ]
    }
  ]
}
